{
  "manifest_version": 2,
  "name": "Aura Bridge",
  "version": "1.0",
  "description": "Мост между Аурой и вкладками Firefox",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "activeTab",
    "scripting"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "aura-bridge@pythonvenom.local",
      "strict_min_version": "91.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.max.ru/*",
        "*://max.ru/*"
      ],
      "js": [
        "content_max.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://web.whatsapp.com/*"
      ],
      "js": [
        "content_whatsapp.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "*://vk.com/*",
        "*://*.vk.com/*",
        "*://vk.ru/*",
        "*://*.vk.ru/*"
      ],
      "js": [
        "content_vk.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://web.telegram.org/*"
      ],
      "js": [
        "content_telegram.js"
      ],
      "run_at": "document_idle"
    }
  ]
}