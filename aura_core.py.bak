            'context_memory': AgentContextMemory(),
            'parallel_universe': AgentParallelUniverse(),
            'focus_switch': AgentFocusSwitch(),
            'app_controller': AgentAppController(),
            'music_ducker': AgentMusicDucker(),
            'router': AgentRouter(),
            'update_notifier': AgentUpdateNotifier(),
            'auto_task': AgentAutoTask(),
            'update_watcher': AgentUpdateWatcher(),
            'smart_browser': AgentSmartBrowser(),
            'browser_controller': AgentBrowserController(),
            'mouse': AgentMouse(),
            'journal_browser': AgentJournalBrowser(),
            'vk_music': AgentVKMusic(),
            'security': AgentSecurity(),
            'audio_router': AgentAudioRouter(),
            
        }
        self.running = True
        self.last_notification_time = time.time()
        
        # Активируем основные агенты
        self.agents['listener'].active = True
        self.agents['speaker'].active = True
        
        # Проверка VK при старте (без открытия браузера!)
        if self.agents['vk_music'].token:
            print("✅ VK Music готов (токен загружен)")
        else:
            print("⚠️ VK Music: токен не найден, проверьте vk_token.txt")
    
    def process(self, text):
        text_lower = text.lower().strip()
        
        # Логирование
        try:
            self.agents['registry'].log("command", {"command": text})
        except:
            pass
        
        # ===== VK МУЗЫКА (явные команды) =====
        vk_patterns = [
            'включи музык', 'включи песн', 'включи трек',
            'найди музык', 'найди песн', 'найди трек',
            'добавь песн', 'добавь трек', 'добавь в плейлист',
            'лайк песн', 'лайк трек', 'поставь лайк',
            'открой музыку вк', 'открой вк музык'
        ]
        for pattern in vk_patterns:
            if pattern in text_lower:
                return self.agents['vk_music'].execute(text_lower)
        
        # "Найди [исполнитель]" - если есть музыкальные индикаторы
        if 'найди' in text_lower:
            music_words = ['музык', 'песн', 'трек', 'исполнител', 'групп']
            if any(w in text_lower for w in music_words):
                return self.agents['vk_music'].execute(text_lower)
        
        # ===== ГРОМКОСТЬ =====
        if 'громк' in text_lower or ('звук' in text_lower and 'вк' not in text_lower):
            return self.agents['audio_pult'].execute(text_lower)
        
        # ===== БЕЗОПАСНОСТЬ =====
        if 'проверь' in text_lower and ('безопасн' in text_lower or 'процесс' in text_lower or 'порт' in text_lower):
            return self.agents['security'].execute(text_lower)
        
        # ===== РАБОТА / ПРОЕКТ =====
        if 'работа' in text_lower or 'проект' in text_lower:
            return self.agents['focus_switch'].execute(text_lower)
        
        # ===== ФОКУС =====
        if 'фокус' in text_lower:
            return self.agents['focus_switch'].execute(text_lower)
        
        # ===== БРАУЗЕР / ВК / РУТУБ / ЮТУБ =====
        if any(w in text_lower for w in ['выведи', 'рутуб', 'ютуб', 'открой вк', 'открой браузер']):
            return self.agents['smart_browser'].execute(text_lower)
        
        if text_lower.strip() == 'вк' or 'вконтакте' in text_lower:
            return self.agents['smart_browser'].execute(text_lower)
        
        # ===== ВРЕМЯ =====
        if any(word in text_lower for word in ['время', 'врем', 'час', 'который час']):
            return self.agents['time'].execute(None)
        elif 'день недели' in text_lower or 'какой день' in text_lower or 'дата' in text_lower:
            return self.agents['time'].execute_with_command(text)
        
        # ===== ОБНОВЛЕНИЯ =====
        elif 'обновл' in text_lower:
            return self.agents['updates'].execute(None)
        elif 'обнови' in text_lower:
            return self.agents['upgrader'].execute(None)
        
        # ===== ЭКРАН =====
        elif 'скриншот' in text_lower:
            return self.agents['vision'].execute(text_lower)
        
        # ===== ПОИСК В ИНТЕРНЕТЕ =====
        elif 'найди' in text_lower or 'поиск' in text_lower:
            return self.agents['internet'].execute(text_lower)
        
        # ===== ПОГОДА =====
        elif 'погода' in text_lower or 'температура' in text_lower:
            return self.agents['weather'].execute(text_lower)
        
        # ===== ОКНА =====
        elif 'рабочий стол' in text_lower or 'раздели экран' in text_lower:
            return self.agents['window_manager'].execute(text_lower)
        
        # ===== ТЕКСТ =====
        elif 'копируй' in text_lower or 'вставь' in text_lower or 'выдели' in text_lower:
            return self.agents['text_editor'].execute(text_lower)
        
        # ===== ФУНКЦИИ =====
        elif 'функци' in text_lower or 'возможност' in text_lower or 'умеешь' in text_lower:
            return self.agents['functions'].execute(None)
        
        # ===== ПАМЯТЬ =====
        elif 'покажи память' in text_lower:
            return self.agents['registry'].execute(text_lower)
        elif 'запомни' in text_lower or 'что ты помнишь' in text_lower:
            return self.agents['vault'].execute(text_lower)
        
        # ===== КОД =====
        elif 'код' in text_lower or 'сгенерируй' in text_lower:
            return self.agents['code_helper'].execute(text_lower)
        
        # ===== ЗАДАЧИ =====
        elif 'задача' in text_lower or 'выполни все' in text_lower:
            return self.agents['task_executor'].execute(text_lower)
        
        # ===== АВТОНОМНЫЙ РЕЖИМ =====
        elif 'автономный' in text_lower or 'сам работай' in text_lower:
            return self.agents['auto_task'].execute(text_lower)
        
        # ===== СЛОЖНЫЙ ВОПРОС =====
        elif any(word in text_lower for word in ['почему', 'расскажи', 'объясни', 'что такое', 'как работает', 'кто такой', 'зачем']):
            return self.agents['brain'].execute(text_lower)
        
        # ===== ВОССТАНОВИ БРАУЗЕР =====
        elif 'восстанови' in text_lower or 'журнал' in text_lower:
            return self.agents['journal_browser'].execute(text_lower)
        
        # ===== ФОЛБЭК =====
        else:
            return "Не расслышала, Создатель, повторите"

    def run(self):
        print("\n" + "="*60)
        print("🦾 АУРА - ЯДРО v10.1 FINAL")
        print("🔴 Скажи 'Аура' для активации")
        print("📦 VK Music | 🛡️ Security | 🏠 Smart Home | 🤖 Auto")
        print("="*60)
        print(f"\n✅ {len(self.agents)} агентов загружены!\n")
        
        self.agents['listener'].active = True
        self.agents['speaker'].active = True
        
        while self.running:
            try:
                # Проверка аудио-маршрутизации
                self.agents['audio_router'].check_and_route()
                
                # === АНТИ-ЭХО: не слушаем, пока говорим ===
                if self.agents['speaker'].is_speaking:
                    time.sleep(0.1)
                    continue
                # ============================================
                
                heard = self.agents['listener'].listen(timeout=3)

                # Проверка обновлений каждые 5 минут
                if time.time() - self.last_notification_time > 300:
                    self.agents['speaker'].active = True
                    res = self.agents['update_notifier'].execute()
                    if '⚠️' in res:
                        print(f"🤖 Уведомление: {res}")
                        self.agents['speaker'].say(res)
                    self.last_notification_time = time.time()
                    self.agents['speaker'].active = False
                
                if heard:
                    if 'аура' not in heard.lower() and 'aura' not in heard.lower():
                        # Просто игнорируем, без ответа
                        continue
                    
                    print("🔔 Активация!")
                    cmd = heard.replace('аура', '').replace('aura', '').strip()
                    
                    # Приглушаем музыку
                    try:
                        subprocess.run(['pactl', 'set-sink-volume', '@DEFAULT_SINK@', '30%'], check=False)
                    except:
                        pass
                    
                    # Обработка подтверждения обновления
                    if self.agents['upgrader'].waiting_for_confirmation:
                        if 'да' in cmd:
                            self.agents['upgrader'].waiting_for_confirmation = False
                            response = self.agents['upgrader'].confirm()
                        elif 'нет' in cmd or 'отмена' in cmd:
                            self.agents['upgrader'].waiting_for_confirmation = False
                            response = "⏹️ Обновление отменено."
                        else:
                            if self.agents['upgrader'].increment_attempts():
                                self.agents['upgrader'].waiting_for_confirmation = False
                                response = "⏱️ Время вышло. Обновление отменено."
                            else:
                                response = "Повторите: скажите 'да' или 'нет'."
                        print(f"🤖 {response}")
                        self.agents['speaker'].say(response)
                        continue
                    
                    # Перебиваем Ауру
                    if self.agents['speaker'].aplay_process and self.agents['speaker'].aplay_process.poll() is None:
                        print("🛑 Перебиваю Ауру...")
                        self.agents['speaker'].stop_speaking()
                        continue

                    if cmd:
                        print(f"📝 Команда: {cmd}")
                        self.agents['speaker'].active = True
                        response = self.process(cmd)
                        print(f"🤖 {response}")
                        self.agents['speaker'].say(response)
                        
                        if self.agents['speaker'].aplay_process:
                            self.agents['speaker'].aplay_process.wait()
                        
                        if "\n" in response:
                            time.sleep(1.5)
                        else:
                            time.sleep(0.5)
                        self.agents['speaker'].active = False
                        
                        # Восстанавливаем громкость
                        try:
                            subprocess.run(['pactl', 'set-sink-volume', '@DEFAULT_SINK@', '100%'], check=False)
                        except:
                            pass
                    else:
                        print("⏳ Не расслышала команду")
                time.sleep(0.1)
                
            except KeyboardInterrupt:
                print("\n🦾 Аура: До свидания! 👋")
                break
            except Exception as e:
                print(f"❌ Ошибка: {e}")
                time.sleep(0.5)

# ============================================================
# ЗАПУСК
# ============================================================

if __name__ == "__main__":
    aura = AuraCore()
    core = aura  # для обратной совместимости
    aura.run()
