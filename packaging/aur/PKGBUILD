# Maintainer: pythonvenom <https://github.com/PythonVenom\>
# Aura — локальный голосовой помощник (elder care, accessibility)
# Наука: Arch packaging (PKGBUILD spec), PEP 517 (Python build)

pkgname=aura-companion
pkgver=0.7.9
pkgrel=1
pkgdesc="Локальный голосовой помощник (elder care, accessibility)"
arch=('any')
url="https://github.com/PythonVenom/aura-companion"
license=('MIT')
depends=(
    'python'
    'python-pip'
    'pipewire'
    'pipewire-pulse'
    'wireplumber'
    'libpulse'
    'playerctl'
    'qt6-tools'
)
optdepends=(
    'speech-dispatcher: TTS для незрячих'
    'espeak-ng: fallback TTS'
    'alsa-utils: запись (arecord) для ASR'
    'firefox: native messaging bridge'
    'ollama: локальный LLM'
    'kdeconnect: SMS bridge'
)
provides=('aura')
conflicts=()
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/v${pkgver}.tar.gz")
sha256sums=('SKIP')  # TODO: заполнить после релиза

build() {
    cd "${srcdir}/${pkgname}-${pkgver}" 2>/dev/null || cd "${srcdir}/${pkgname}"
    python -m build --wheel --no-isolation
}

package() {
    cd "${srcdir}/${pkgname}-${pkgver}" 2>/dev/null || cd "${srcdir}/${pkgname}"
    python -m installer --destdir="${pkgdir}" dist/*.whl

    # Документация
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"

    # Symlink для CLI
    install -d "${pkgdir}/usr/bin"
    ln -sf "/usr/bin/aura_main.py" "${pkgdir}/usr/bin/aura" 2>/dev/null || true
}
